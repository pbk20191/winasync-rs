/target
# The benchmark harness is its own workspace, so its build output is its own.
/tools/bench/target
# So is the LTO probe; `out/` is what its build.sh links.
/tools/lto-probe/target
/tools/lto-probe/out
# The static library's consumer probe builds the library as LTO bitcode into
# its own target dir, and links into out/.
/static/probe/target
/static/probe/out

# The Python projection is generated by `python/stage.sh` from the winmd.
python/out/
python/.venv/
python/__pycache__/

# C# build output; the projection under obj/ is generated from the winmd.
csharp/bin/
csharp/obj/

# The Node projection is generated by `node/stage.sh` from the winmd.
node/out/
node/node_modules/
