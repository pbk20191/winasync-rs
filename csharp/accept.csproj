<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reg-free WinRT: the <activatableClass> entries ride on the exe's
         own manifest, so there is no registry read and no CreateActCtx. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Project the third-party namespace out of the winmd referenced below. -->
    <CsWinRTIncludes>Rustwinui3loop</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- CsWinRT turns every .winmd on the reference path into a projection
         input, then removes it from the compiler references. -->
    <Reference Include="rustwinui3loop-metadata">
      <HintPath>../metadata/rustwinui3loop.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The component itself, copied after the build rather than as Content.
       As Content it lands in the output directory early, where assembly
       resolution examines it and fails with "PE image does not have
       metadata": it is a native DLL, not a managed one. -->
  <Target Name="CopyComponent" AfterTargets="Build">
    <Copy SourceFiles="../target/debug/rustwinui3loop.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
