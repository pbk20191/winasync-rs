; Export list for winasync_ps.dll. PRIVATE keeps these out of the import
; library, as in dll/exports.def: COM reaches them by `GetProcAddress`.
;
; No `DllRegisterServer`. The installer writes the `ProxyStubClsid32` keys,
; for the same reason `winasync.dll` does not register itself (see
; src/comio/activation.rs). The IIDs to write are the library's
; `activation::PROXIED_IIDS`.
EXPORTS
    DllGetClassObject       PRIVATE
    DllCanUnloadNow         PRIVATE
